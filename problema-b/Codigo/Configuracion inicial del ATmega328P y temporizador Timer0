#if WDT_TEST == 1

static void wdt_interrupt_start(void) {
    uint8_t sreg = SREG;
    cli();
    wdt_reset();
    MCUSR &= ~(1 << WDRF);

    __asm__ __volatile__(
        "sts %[wdt], %[open]"
        "\n\t"
        "sts %[wdt], %[mode]"
        :
        : [wdt] "n"(_SFR_MEM_ADDR(WDTCSR)),
          [open] "r"((uint8_t)((1 << WDCE) | (1 << WDE))),
          [mode] "r"((uint8_t)((1 << WDIE) | (1 << WDP3) | (1 << WDP0)))
        : "memory"
    );

    SREG = sreg;
}

ISR(WDT_vect) {
    wdt_count++;
    wdt_pending = 1;
}

static uint16_t wdt_read_adc0(void) {
    PRR &= ~(1 << PRADC);
    ADMUX = (1 << REFS0);

    ADCSRA = (1 << ADEN) |
             (1 << ADPS2) |
             (1 << ADPS1) |
             (1 << ADPS0);

    ADCSRA |= (1 << ADSC);

    while (ADCSRA & (1 << ADSC)) {
    }

    uint16_t value = ADC;

    ADCSRA &= ~(1 << ADEN);
    PRR |= (1 << PRADC);

    return value;
}

