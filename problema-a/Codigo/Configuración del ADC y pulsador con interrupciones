static void adc_init(void)
{
	ADMUX = (1 << REFS0);

	ADCSRA = (1 << ADEN) | (1 << ADIE) | (1 << ADPS2) | (1 << ADPS1) |(1 << ADPS0);

	DIDR0 = (1 << ADC0D);
}


ISR(ADC_vect)
{
	adc_value = ADC;
}


static void button_init(void)
{
	DDRD &= ~(1 << BUTTON);
	PORTD |= (1 << BUTTON);
	EICRA = (1 << ISC01);
	EIFR = (1 << INTF0);
	EIMSK = (1 << INT0);
}


ISR(INT0_vect)
{
	if (!button_pending)
	{
		button_time = ms;
		button_pending = 1;
	}
}
