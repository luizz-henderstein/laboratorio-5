static void dht_init(void)
{
	DDRD &= ~(1 << DHT);
	PORTD |= (1 << DHT);

	PCICR |= (1 << PCIE2);
	PCMSK2 &= ~(1 << PCINT20);
}


static uint16_t timer1_elapsed(
uint16_t now,
uint16_t before)
{
	if (now >= before)
	return now - before;

	return (uint16_t)
	(25000U - before + now);
}


ISR(PCINT2_vect) //Detecta los cambios de señal del DHT11	
{
	uint8_t high = (PIND & (1 << DHT)) != 0;
	uint16_t t = TCNT1;
	if (dht_state == DHT_RESPONSE_LOW && !high)
	{
		dht_state = DHT_RESPONSE_HIGH;
	}
	else if (dht_state == DHT_RESPONSE_HIGH && high)
	{
		dht_state = DHT_FIRST_LOW;
	}
	else if (dht_state == DHT_FIRST_LOW && !high)
	{
		dht_state = DHT_BIT_HIGH;
	}
	else if (dht_state == DHT_BIT_HIGH && high)
	{
		dht_rise_count = t;
		dht_state = DHT_BIT_END;
	}
	else if (dht_state == DHT_BIT_END && !high)
	{
		uint16_t ticks = timer1_elapsed(t, dht_rise_count);
		uint8_t byte_index = dht_count / 8;
		dht_data[byte_index] <<= 1;
		if (ticks > 12) dht_data[byte_index] |= 1;
		dht_count++;
		if (dht_count == 40)
		{
			PCMSK2 &= ~(1 << PCINT20);
			dht_state = DHT_DONE;
		}
		else
		{
			dht_state = DHT_BIT_HIGH;
		}
	}
}


static void dht_task(
uint32_t now,
uint8_t *temp,
uint8_t *valid,
uint8_t enabled)
{
	static uint8_t phase = 0;

	static uint32_t last_start = 0;
	static uint32_t start_low = 0;
	static uint32_t start_receive = 0;

	if (!enabled)
	{
		PCMSK2 &= ~(1 << PCINT20);

		DDRD &= ~(1 << DHT);
		PORTD |= (1 << DHT);

		dht_state = DHT_IDLE;
		phase = 0;

		return;
	}

	if (phase == 0 && due(now, last_start, 2000))
	{
		last_start = now;
		start_low = now;

		PORTD &= ~(1 << DHT);
		DDRD |= (1 << DHT);

		phase = 1;
	}
	else if (phase == 1 && due(now, start_low, 20))
	{
		ATOMIC_BLOCK(
		ATOMIC_RESTORESTATE)
		{
			dht_count = 0;

			for (uint8_t i = 0;
			i < 5;
			i++)
			{
				dht_data[i] = 0;
			}

			dht_state =
			DHT_RESPONSE_LOW;

			PCIFR = (1 << PCIF2);
			PCMSK2 |= (1 << PCINT20);

			DDRD &= ~(1 << DHT);
			PORTD |= (1 << DHT);
		}

		start_receive = now;
		phase = 2;
	}
	else if (phase == 2)
	{
		uint8_t state;

		ATOMIC_BLOCK(ATOMIC_RESTORESTATE)
		{
			state = dht_state;
		}

		if (state == DHT_DONE)
		{
			uint8_t data[5];

			ATOMIC_BLOCK(ATOMIC_RESTORESTATE)
			{
				for (uint8_t i = 0; i < 5; i++)
				{
					data[i] = dht_data[i];
				}

				dht_state = DHT_IDLE;
			}

			if ((uint8_t)
			(data[0] + data[1] + data[2] + data[3]) == data[4])
			{
				*temp = data[2];
				*valid = 1;
			}
			else
			{
				*valid = 0;
			}

			phase = 0;
		}
		else if (due(now, start_receive, 10))
		{
			ATOMIC_BLOCK(ATOMIC_RESTORESTATE)
			{
				PCMSK2 &= ~(1 << PCINT20);

				dht_state = DHT_IDLE;
			}

			*valid = 0;
			phase = 0;
		}
	}
}
